{
  "manifest_version": 3,
  "name": "Brain Desk",
  "version": "0.2.0",
  "description": "Add, draft and log LinkedIn outreach and inbound companies to Brain Desk (canaan-brain vault).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Log to Brain Desk",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:47817/*"]
}
